+// Source roots need not be src/. Use the analyzed file's real directory for
+// both direct modules and ancestor folders containing only nested modules.
+function actualFolderDirectory(graph, folder) {
+    const module = graph.modules.find((entry) => entry.folder === folder) ??
+        graph.modules.find((entry) => folder === "." || entry.folder.startsWith(`${folder}/`));
+    if (module === undefined) {
+        return path.join(graph.projectRoot, sourceFolderPath(folder));
+    }
+    let directory = path.dirname(module.fileName);
+    const depth = module.folder === "." ? 0 : module.folder.split("/").length;
+    const targetDepth = folder === "." ? 0 : folder.split("/").length;
+    for (let index = targetDepth; index < depth; index += 1) {
+        directory = path.dirname(directory);
+    }
+    return directory;
+}
