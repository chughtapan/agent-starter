{
  "name": "social-harness",
  "version": "0.6.0",
  "description": "Collaboration for the coding agents people already use.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chughtapan/agent-starter.git"
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "social-harness": "dist/upgrades/bootstrap.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "architecture": "safer-architecture-lsp check .",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm architecture && pnpm typecheck && pnpm test",
    "clean": "rimraf dist .evals-build",
    "evals:build": "tsc -p tsconfig.evals.json",
    "evals": "pnpm evals:build && node .evals-build/cli.js",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content --concurrency off --max-warnings 0 && agent-code-guard-knip",
    "effect:prepare": "./scripts/prepare-effect.sh",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.98",
    "@effect/platform-node-shared": "4.0.0-beta.98",
    "effect": "4.0.0-beta.98",
    "nunjucks": "3.2.4"
  },
  "devDependencies": {
    "@chughtapan/safer-architecture-lsp": "0.3.1",
    "@effect/vitest": "4.0.0-beta.98",
    "@types/node": "24.3.0",
    "@types/nunjucks": "3.2.6",
    "eslint": "9.39.5",
    "eslint-plugin-agent-code-guard": "0.0.21",
    "prettier": "3.6.2",
    "rimraf": "6.1.3",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
