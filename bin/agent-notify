#!/usr/bin/env bash
# agent-notify TITLE BODY [URL] — desktop notification attributed to the agent; a click opens URL.
# macOS: the per-agent app ~/.agentmail/<name>.app (assets/notifier.swift, built by bin/install),
# launched through LaunchServices so macOS accepts the authorization; it stays resident until the
# click. Falls back to plain osascript (no click target) when the app is missing; Linux: notify-send.
# The app records the Allow/Deny answer in ~/.agentmail/notify-state; on "denied" this prints
# "notifications: not allowed" and exits 2; otherwise silent.
# No-op when AGENT_BRIEF_NO_NOTIFY is set.
set -u
[ -n "${AGENT_BRIEF_NO_NOTIFY:-}" ] && exit 0
title="${1:-}"; body="${2:-}"; url="${3:-}"; [ -n "$title" ] || exit 0
home="${AGENTMAIL_HOME:-$HOME/.agentmail}"
if [ "$(uname)" = Darwin ]; then
  app=$(ls -d "$home"/*.app 2>/dev/null | head -1)
  if [ -n "$app" ] && [ -x "$app/Contents/MacOS/notifier" ]; then
    [ "$(cat "$home/notify-state" 2>/dev/null)" = denied ] && { echo "notifications: not allowed — System Settings › Notifications › $(basename "$app" .app)"; exit 2; }
    open -n "$app" --args "$title" "$body" "$url" >/dev/null 2>&1 && exit 0
  fi
  command -v osascript >/dev/null 2>&1 && \
    osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$title" "$body" >/dev/null 2>&1
elif command -v notify-send >/dev/null 2>&1; then
  notify-send "$title" "$body" >/dev/null 2>&1
fi
exit 0
