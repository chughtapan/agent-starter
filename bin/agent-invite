#!/usr/bin/env bash
# agent-invite [NAME] — print the README install message with this team's facilitator filled in.
# That is the whole teammate hand-off; nothing is sent. Facilitator comes from AGENTS.md ("Who I am").
set -u
here="$(cd "$(dirname "$0")" && pwd)"; repo="$(dirname "$here")"
who="${1:-}"
fac=$(sed -n 's/.*Facilitator: \*\*\([^*]*\)\*\* <\([^>]*\)>.*/\1 <\2>/p' "$repo/AGENTS.md" | head -1)
[ -n "$fac" ] && ! printf '%s' "$fac" | grep -q '{{' || { echo "AGENTS.md has no facilitator yet (run onboard)"; exit 2; }
msg=$(sed -n '/^## Install — tell your Claude/,/^## /p' "$repo/README.md" | grep '^> ' | head -1 | sed 's/^> //')
[ -n "$msg" ] || { echo "README.md has no install message"; exit 2; }
msg=$(printf '%s' "$msg" | sed "s#\*\*\`<facilitator name> <facilitator address>\`\*\*#**\`$fac\`**#")
[ -n "$who" ] && echo "For $who — paste this into Claude Code (the terminal, or Claude Desktop → Code tab):" && echo
printf '%s\n' "$msg"
echo
echo "You need Claude Code — the \`claude\` terminal command or Claude Desktop → Code tab. Not the Claude chat window, not OpenClaw. It asks two questions and one 6-digit code that AgentMail emails you."
exit 0
